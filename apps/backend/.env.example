# Server Configuration
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=mysql://root:password@localhost:3306/karya_kreatif_andalan

# JWT Authentication
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRATION=7d

# Xendit Payment Gateway
XENDIT_API_KEY=your-xendit-api-key
XENDIT_WEBHOOK_TOKEN=your-xendit-webhook-token

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=karya-kreatif-andalan
R2_PUBLIC_URL=https://your-r2-bucket.r2.dev

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
